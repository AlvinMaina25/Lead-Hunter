# Copy this file to .env and fill in your real values.
# Never commit the real .env file — it is already excluded in .gitignore.

# Phase 23B1: shared credential required to reach ANY route (API or the
# built frontend) — see server/lib/basicAuth.js. REQUIRED when
# NODE_ENV=production; the server refuses all requests without it.
# Optional in local dev (requests pass through unauthenticated if unset).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Phase 7: Google Places API (New) key, used server-side only by
# server/lib/googlePlaces.js to power POST /api/searches. Never put a
# real value here, and never expose this key to frontend/Vite code.
GOOGLE_PLACES_API_KEY=

# Phase 10A: Google PageSpeed Insights API key, used server-side only by
# server/lib/pagespeedInsights.js to power website analysis scoring.
# Never put a real value here, and never expose this key to
# frontend/Vite code.
PAGESPEED_API_KEY=

# Phase 11B: Google Gemini API key, used server-side only by
# server/lib/aiOpportunityAnalysis.js to power AI opportunity analysis
# (POST /api/businesses/:id/opportunity-analysis). Get one at
# https://aistudio.google.com/apikey (Gemini's free tier works fine
# for this). Never put a real value here, and never expose this key to
# frontend/Vite code.
GEMINI_API_KEY=

# Optional. Overrides the default Gemini model
# (server/lib/aiOpportunityAnalysis.js's DEFAULT_MODEL, currently
# gemini-3.8-flash) used for opportunity analysis. If Gemini ever
# starts returning HTTP 404 "model not found" again, the model you're
# pointing at has likely been deprecated -- check the current list at
# https://ai.google.dev/gemini-api/docs/models.
GEMINI_MODEL=
