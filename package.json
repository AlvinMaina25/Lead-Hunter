{
  "name": "alvin-lead-hunter",
  "version": "0.2.0",
  "description": "Internal lead-generation and sales-intelligence platform for Alvin Solutions.",
  "private": true,
  "main": "db/pool.js",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "test:connection": "node scripts/test-connection.js",
    "backfill:international-phone": "node scripts/backfill-international-phone.js",
    "test": "node --test server/lib/__tests__/*.test.js",
    "dev:api": "node server/index.js",
    "dev:web": "npm --prefix frontend run dev",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "npm --prefix frontend run build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "wrangler": "^4.156.1"
  }
}
